# Safe Deployments Lab — Environment Variables
# =============================================
# Copy this file to .env and fill in real values
# NEVER commit .env to source control

# ── Required ─────────────────────────────────
# Scenario A: Missing this = app starts but /api/records fails
DATABASE_URL=postgresql://user:password@localhost:5432/appdb

# Scenario B: Wrong value = app runs with wrong config
# Valid values: development | staging | production
APP_ENV=staging

# Scenario C: Missing/wrong = app starts but /api/files fails
STORAGE_BUCKET=your-gcs-bucket-name

# ── Optional ─────────────────────────────────
APP_VERSION=1.0.0
